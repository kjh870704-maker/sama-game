  "dialogues": [
    {
      "id": "bribe",
      "speaker": "patrol_north",
      "text": "야밤에 어디를 가는 길인가?",
      "options": [
        {
          "id": "pay",
          "text": "노잣돈을 쥐여준다.",
          "correct": true
        },
        {
          "id": "fight",
          "text": "베고 지나간다.",
          "correct": false,
          "next": "fight_confirm"
        },
        {
          "id": "lie",
          "text": "관의 일로 나왔다고 둘러댄다.",
          "correct": false,
          "next": "lie_failed"
        }
      ]
    },
    {
      "id": "lie_failed",
      "text": "순찰병의 눈초리가 날카로워진다. \"패를 보여라.\"",
      "options": [
        {
          "id": "pay_late",
          "text": "결국 노잣돈을 내민다.",
          "correct": true
        }
      ]
    },
    {
      "id": "fight_confirm",
      "text": "칼을 뽑으면 성문까지 조용히 갈 길은 사라진다.",
      "options": [
        {
          "id": "commit",
          "text": "그래도 벤다.",
          "correct": false
        }
      ]
    },
    {
      "id": "gate_payment",
      "text": "남문 너머로 피난길이 이어진다. 문지기가 통행료 1,000전을 요구한다.",
      "options": [
        {
          "id": "pay_gate",
          "text": "통행료를 내고 형제와 함께 성을 떠난다."
        }
      ]
    }
  ],
